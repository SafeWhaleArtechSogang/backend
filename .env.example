# 로컬 Docker Compose용 예시입니다. 이 파일을 .env로 복사해 사용하세요.
BACKEND_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=safewhale
POSTGRES_USER=safewhale
POSTGRES_PASSWORD=change-me-local

# `openssl rand -base64 64`로 생성한 값을 입력하세요.
JWT_SECRET=replace-with-a-random-base64-secret
CORS_ALLOWED_ORIGINS=http://localhost:5175
IMAGE_TAG=local

# 실제 Google 로그인에서 프론트와 동일한 Web Client ID를 사용합니다.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# 아직 목 구현체인 외부 AI 연동용 자리표시자입니다.
AI_API_KEY=mock-not-used

# ── AI 서버(ai-server, FastAPI) 연동 ──
# mock: 목 응답만 쓴다. http: ai-server 를 실제로 호출한다 (신고 플로우 질문/초안이 Gemini 로 간다).
AI_MODE=mock
# ai-server 는 별도 compose 프로젝트이므로 호스트 포워딩 포트를 가리킨다.
AI_SERVER_BASE_URL=http://host.docker.internal:8000

# ── AI 서버 → 백엔드 내부 API(C-1/C-2/C-5) 인증 ──
# ai-server 의 .env AGENT_TOKEN 과 반드시 같은 값이어야 한다.
AGENT_TOKEN=dev-agent-token
